---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---

<Layout title={`Page not found | ${profile.name}`}>
  <main class="notfound">
    <p class="code" data-intro style="--i:0">// 404</p>
    <h1 data-intro style="--i:1">This page doesn’t exist<span>.</span></h1>
    <p class="sub" data-intro style="--i:2">The link may be broken, or the page may have moved.</p>
    <p class="links" data-intro style="--i:3">
      <a href="/">← Back home</a>
      <a href="/archive">Project archive</a>
    </p>
  </main>
</Layout>

<style>
  .notfound {
    min-height: 100vh;
    max-width: 720px;
    margin-inline: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .code {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--ink);
  }
  h1 span {
    color: var(--accent);
  }
  .sub {
    margin: 14px 0 0;
  }
  .links {
    display: flex;
    gap: 20px;
    margin: 28px 0 0;
    font-weight: 500;
    color: var(--ink);
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
