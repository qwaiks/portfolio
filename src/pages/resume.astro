---
// Printable one-page résumé. `npm run resume` turns this page into public/Kwaku-Owusu-Ansa-Resume.pdf.
import { profile, projects, education, resume } from '../data/profile';

const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} — Résumé</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="page">
      <header class="top">
        <div>
          <h1>{profile.name}</h1>
          <p class="summary">{resume.summary}</p>
        </div>
        <ul class="contact">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li>{profile.phone}</li>
          <li><a href={profile.github}>{strip(profile.github)}</a></li>
          <li><a href={profile.linkedin}>{strip(profile.linkedin)}</a></li>
        </ul>
      </header>

      <div class="cols">
        <section class="left">
          <h2>Relevant Experience</h2>
          {
            resume.experience.map((job) => (
              <article class="job">
                <p class="job-title">
                  {job.role} · <strong>{job.company}</strong>
                  <span class="date">{job.period}</span>
                </p>
                <ul>
                  {job.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </section>

        <aside class="right">
          <section>
            <h2>Skills</h2>
            {
              resume.skills.map((g) => (
                <div class="block">
                  <h3>{g.title}</h3>
                  <p>{g.items}</p>
                </div>
              ))
            }
          </section>

          <section>
            <h2>Selected Projects</h2>
            {
              projects.slice(0, resume.projectCount).map((p) => (
                <div class="block">
                  <h3>
                    {p.links[0] ? <a href={p.links[0].href}>{p.name}</a> : p.name}
                  </h3>
                  <p>{p.description}</p>
                </div>
              ))
            }
          </section>

          <section>
            <h2>Education</h2>
            <div class="block">
              <h3>{education.school}</h3>
              <p>{education.degree}<br />{education.period}</p>
            </div>
          </section>

          <section>
            <h2>Strengths</h2>
            <p class="plain">{resume.professional}</p>
          </section>
        </aside>
      </div>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: letter;
    margin: 0;
  }
  :root {
    --accent: #047857;
    --ink: #0f172a;
    --text: #334155;
    --muted: #64748b;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    background: #e5e7eb;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .page {
    width: 8.5in;
    height: 11in;
    margin: 24px auto;
    padding: 0.45in 0.55in 0.35in;
    background: #fff;
    box-shadow: 0 10px 40px rgba(15, 23, 42, 0.15);
    overflow: hidden;
  }
  @media print {
    html,
    body {
      background: #fff;
    }
    .page {
      margin: 0;
      box-shadow: none;
    }
  }

  .top {
    display: grid;
    grid-template-columns: 1fr 2.35in;
    column-gap: 0.4in;
    align-items: start;
  }
  h1 {
    margin: 0;
    font-size: 36pt;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
    white-space: nowrap;
  }
  .summary {
    margin: 12pt 0 0;
    max-width: 4.1in;
    font-size: 9.5pt;
    line-height: 1.4;
    color: var(--text);
  }
  .contact {
    list-style: none;
    margin: 4pt 0 0;
    padding: 0;
    font-size: 9pt;
    line-height: 1.55;
    color: var(--text);
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 2.35in;
    column-gap: 0.4in;
    margin-top: 20pt;
  }
  h2 {
    margin: 0 0 9pt;
    font-size: 12.5pt;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .job {
    margin-bottom: 9pt;
  }
  .job-title {
    margin: 0 0 5pt;
    font-size: 10pt;
    color: var(--ink);
  }
  .job-title strong {
    font-weight: 600;
  }
  .date {
    margin-left: 5pt;
    font-size: 7.5pt;
    color: var(--muted);
  }
  .job ul {
    margin: 0;
    padding-left: 13pt;
  }
  .job li {
    margin-bottom: 1pt;
    font-size: 8.2pt;
    line-height: 1.38;
    color: var(--text);
  }
  .job li::marker {
    color: var(--muted);
  }

  .right section {
    margin-bottom: 18pt;
  }
  .block {
    margin-bottom: 8pt;
  }
  h3 {
    margin: 0 0 2pt;
    font-size: 9.5pt;
    font-weight: 600;
    color: var(--ink);
  }
  .block p,
  .plain {
    margin: 0;
    font-size: 8.4pt;
    line-height: 1.45;
    color: var(--text);
  }
</style>
