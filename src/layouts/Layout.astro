---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
}
const { title = `${profile.name} — ${profile.role}` } = Astro.props;
const description = `${profile.role} in ${profile.location}. ${profile.tagline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e13" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <!-- Mark JS as available before first paint so scroll-reveal elements start hidden without flashing -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="dot-spotlight" aria-hidden="true"></div>
    <slot />
    <script>
      const spot = document.querySelector<HTMLElement>('.dot-spotlight');
      if (spot && matchMedia('(pointer: fine)').matches) {
        window.addEventListener('pointermove', (e) => {
          spot.style.setProperty('--x', `${e.clientX}px`);
          spot.style.setProperty('--y', `${e.clientY}px`);
        });
      }

      // Reveal [data-reveal] elements as they scroll into view (once each)
      const revealables = document.querySelectorAll('[data-reveal], [data-draw]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        revealables.forEach((el) => io.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('revealed'));
      }
    </script>
  </body>
</html>
