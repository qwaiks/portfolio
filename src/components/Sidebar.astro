---
import { profile } from '../data/profile';

const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
];
---

<header class="sidebar">
  <div>
    <p class="hello" data-intro style="--i:0">hello, I’m</p>
    <h1 data-intro style="--i:1"><a href="/">{profile.name}<span class="dot">.</span></a></h1>
    <p class="role" data-intro style="--i:2"><span class="pulse" aria-hidden="true"></span>{profile.role}</p>
    <p class="tagline" data-intro style="--i:3">{profile.tagline}</p>

    <nav class="nav" aria-label="In-page" data-intro style="--i:4">
      <ol>
        {
          sections.map((s, i) => (
            <li>
              <a href={`#${s.id}`} data-nav={s.id} class:list={{ active: i === 0 }}>
                <span class="num">0{i + 1}</span>
                <span class="label">{s.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <div class="bottom" data-intro style="--i:5">
    <ul class="socials" aria-label="Contact links">
      <li>
        <a href={profile.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"
            ></path></svg
          >
          GitHub
        </a>
      </li>
      <li>
        <a href={profile.linkedin} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
            ></path></svg
          >
          LinkedIn
        </a>
      </li>
      <li>
        <a href={`mailto:${profile.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg
          >
          Email
        </a>
      </li>
      <li>
        <a href={profile.cv} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6M16 13H8M16 17H8"></path></svg
          >
          Résumé
        </a>
      </li>
    </ul>
    <p class="clock">
      {profile.location} · <time data-clock>--:--</time> GMT
    </p>
  </div>
</header>

<script>
  const el = document.querySelector('[data-clock]');
  const tick = () => {
    if (el)
      el.textContent = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'Africa/Accra',
      }).format(new Date());
  };
  tick();
  setInterval(tick, 30_000);
</script>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 0;
      max-height: 100vh;
      width: 44%;
      padding-block: 88px 64px;
    }
  }
  .hello {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    color: var(--ink);
    font-size: clamp(38px, 4.8vw, 54px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .dot {
    color: var(--accent);
  }
  .role {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 18px 0 0;
    padding: 5px 14px 5px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
    background: var(--surface);
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.6);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(var(--accent-rgb), 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0);
    }
  }
  .tagline {
    margin: 18px 0 0;
    max-width: 340px;
    font-size: 17px;
  }

  .nav {
    display: none;
  }
  @media (min-width: 1024px) {
    .nav {
      display: block;
      margin-top: 48px;
    }
  }
  .nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-block: 7px;
    transition: transform 0.2s ease;
  }
  .num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    transition: color 0.2s ease;
  }
  .label {
    font-family: var(--display);
    font-size: 17px;
    font-weight: 500;
    color: var(--faint);
    transition: color 0.2s ease;
  }
  .nav a:hover,
  .nav a:focus-visible,
  .nav a.active {
    transform: translateX(6px);
  }
  .nav a:hover .label,
  .nav a.active .label {
    color: var(--ink);
  }
  .nav a:hover .num,
  .nav a.active .num {
    color: var(--accent);
  }

  .bottom {
    margin-top: 32px;
  }
  .socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    background: var(--surface);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .socials a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .socials svg {
    width: 15px;
    height: 15px;
  }
  .clock {
    margin: 16px 0 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
  }
</style>
